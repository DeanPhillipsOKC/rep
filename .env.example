VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backlog item 15: public half of the VAPID keypair used for rest timer push
# notifications. Safe to ship to the browser (it's what identifies this app
# to the push service, not a secret) — see docs/architecture.md#push-notifications.
# The private half is an Edge Function secret only (`supabase secrets set
# VAPID_PRIVATE_KEY=...`), never set here or in Cloudflare Pages.
VITE_VAPID_PUBLIC_KEY=

# Local/test-only — never set these in Cloudflare Pages, never commit real values.
# Used by `npm run test:session` (docs/architecture.md#authentication) to mint a
# scriptable session for browser/E2E automation, since real auth (passkey + magic
# link) can't be driven by a script.
SUPABASE_SERVICE_ROLE_KEY=
TEST_ACCOUNT_EMAIL=

# Optional — never set these in Cloudflare Pages. Used by scripts/Send-Notification.ps1 to email
# a description of each shipped/blocked backlog item from any next-item run (interactive,
# headless, or via scripts/Run-Backlog.ps1's loop), plus a run-finished summary from
# Run-Backlog.ps1 itself. Unset means notifications are silently skipped. See
# docs/backlog-runner.md for setup (Gmail App Password, not your normal Gmail password).
GMAIL_SENDER_ADDRESS=
GMAIL_APP_PASSWORD=
NOTIFY_EMAIL_RECIPIENTS=
